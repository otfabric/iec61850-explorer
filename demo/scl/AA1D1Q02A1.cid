							</DAI>
							<DAI name="swRev">
								<Val>2.4.0</Val>
							</DAI>
							<DAI name="serNum">
								<Val>FPC-615-264411</Val>
							</DAI>
							<DAI name="model">
								<Val>FPC-615</Val>
							</DAI>
