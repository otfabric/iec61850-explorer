							</RptEnabled>
						</ReportControl>
						<DOI name="NamPlt">
							<DAI name="vendor">
								<Val>OT Fabric Demo</Val>
							</DAI>
							<DAI name="swRev">
								<Val>2.4.0</Val>
							</DAI>
							<DAI name="d">
								<Val>Protection</Val>
							</DAI>
							<DAI name="configRev">
								<Val>AA1-2026-11-03</Val>
							</DAI>
