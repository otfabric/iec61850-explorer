								<Val sGroup="2">500</Val>
							</DAI>
							<DAI name="minVal">
								<Val>0</Val>
							</DAI>
							<DAI name="maxVal">
								<Val>60000</Val>
							</DAI>
							<DAI name="stepSize">
								<Val>10</Val>
							</DAI>
						</DOI>
					</LN>
					<LN lnClass="PTOC" inst="2" lnType="PTOC_A" desc="Overcurrent I&gt;&gt; (50)">
						<DOI name="StrVal">
							<SDI name="setMag">
								<DAI name="f">
									<Val sGroup="1">4000</Val>
									<Val sGroup="2">5000</Val>
								</DAI>
							</SDI>
							<SDI name="minVal">
								<DAI name="f">
									<Val>100</Val>
								</DAI>
							</SDI>
							<SDI name="maxVal">
								<DAI name="f">
									<Val>20000</Val>
								</DAI>
							</SDI>
							<SDI name="stepSize">
								<DAI name="f">
									<Val>10</Val>
