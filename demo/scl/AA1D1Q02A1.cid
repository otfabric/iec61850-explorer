					<LN lnClass="CSWI" inst="2" lnType="CSWI_SBOE" desc="Disconnector QB1 control"/>
					<LN lnClass="XCBR" inst="1" lnType="XCBR_A" desc="Circuit breaker QA1"/>
					<LN lnClass="XSWI" inst="1" lnType="XSWI_A" desc="Disconnector QB1">
